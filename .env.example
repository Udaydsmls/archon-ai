# ── Core ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=60

# ── Models ────────────────────────────────────────────────────────────────────
PRIMARY_MODEL=claude-sonnet-4-6
CRITIC_MODEL=claude-opus-4-7

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_REFLECTION_CYCLES=3
CRITIQUE_PASS_THRESHOLD=7.0

# ── Storage (default: sqlite for local dev) ───────────────────────────────────
DATABASE_URL=sqlite:///./runs.db
STORAGE_BACKEND=sqlite          # sqlite | dynamo

# DynamoDB (required when STORAGE_BACKEND=dynamo)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMO_RUNS_TABLE=archon_runs
DYNAMO_TENANTS_TABLE=archon_tenants

# ── Vector Store (default: local ChromaDB) ────────────────────────────────────
VECTOR_STORE_PROVIDER=local     # local | pinecone | weaviate
CHROMA_PERSIST_DIR=./chroma_db
USE_HYBRID_RETRIEVAL=false

# Pinecone (required when VECTOR_STORE_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=archon

# Weaviate (required when VECTOR_STORE_PROVIDER=weaviate)
WEAVIATE_URL=localhost

# ── LangSmith Tracing (optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false      # set to true to enable
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=archon-ai

# ── Guardrails (optional) ─────────────────────────────────────────────────────
GUARDRAILS_ENABLED=false        # set to true to enable safety validation
GUARDRAILS_REDACT_PII=true
GUARDRAILS_TOPIC_ALLOWLIST=     # comma-separated topics, empty = no restriction

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
